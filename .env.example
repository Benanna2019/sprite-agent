# Local dev needs no Inngest keys: run against the Inngest Dev Server (INNGEST_DEV=1).
# The agent loop needs a model, reached through the Vercel AI Gateway.

# One key for every provider (OpenAI, Anthropic, etc.) via the Gateway.
AI_GATEWAY_API_KEY=

# Optional. A Vercel AI Gateway model slug, "creator/model".
# Default is openai/gpt-4o-mini. Examples: anthropic/claude-sonnet-4.5, openai/gpt-4o
# UTAH_MODEL=anthropic/claude-sonnet-4.5

# Phase 1 (Fly + Inngest Cloud) only. Set as fly secrets, not in this file.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
